#!/usr/bin/env perl

# 1. コンパイラを lualatex に設定
$lualatex = 'lualatex -synctex=1 -interaction=nonstopmode -file-line-error %O %S';

# 2. PDF生成モードを4に設定
$pdf_mode = 4;

# 3. 文献引用プログラムの設定 (biber を推奨)
$bibtex = 'biber %O %S';

# 4. 索引作成プログラムの設定
$makeindex = 'mendex %O -o %D %S';

# 5. その他の設定 (既存のものを維持)
$max_repeat = 5;
$pvc_view_file_via_temporary = 0;
